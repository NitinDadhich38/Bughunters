# Instagram API Credentials
# Important: Fill these out with your actual credentials.
# This agent is designed to work with the Instagram Graph API, which requires a Facebook Developer account,
# a Facebook App, and a linked Instagram Business or Creator account.

INSTAGRAM_BUSINESS_ACCOUNT_ID="YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID"
INSTAGRAM_ACCESS_TOKEN="YOUR_INSTAGRAM_ACCESS_TOKEN"

# Language Model API Key (e.g., OpenAI, Anthropic)
# Replace with the service you intend to use.
LLM_API_KEY="YOUR_LLM_API_KEY"

# Creator's Information for Personalization
CREATOR_INSTAGRAM_HANDLE="YourInstagramHandle"
CREATOR_NAME="Your Name"
CREATOR_NICHE="Your Niche (e.g., fitness, fashion, tech)"
CREATOR_BIO="A brief bio or value proposition of the creator."
